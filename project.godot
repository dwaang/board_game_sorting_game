; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Board Game Sorting Game"
run/main_scene="uid://1xi766hfay2m"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="uid://dd10381lu0tip"

[autoload]

Bridge="*res://addons/playgama_bridge/bridge.gd"
ControllerIcons="*res://addons/controller_icons/ControllerIcons.gd"
Refs="*uid://3wjfj2fwkkh5"
Events="*uid://crwgtefn01e1i"
Platform="*uid://dgc6k0ed4v3q0"
PauseHandler="*uid://bmuknpgpjrg6k"
DataHandler="*uid://dprji63aq5mc5"
GlobalStageManager="*uid://bpaonfeqipbt"
SoundHandler="*uid://d2u767a7y24ju"
G="*uid://bpw6vxbm0lmek"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_icons/plugin.cfg", "res://addons/minimize_html_build/plugin.cfg", "res://addons/playgama_bridge/plugin.cfg", "res://addons/sticky_scribe/plugin.cfg")

[global_group]

skillnodes=""

[gui]

theme/default_font_antialiasing=0
theme/custom_font="uid://dyvhwvmyhnmoo"

